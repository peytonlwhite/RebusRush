rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    // Content management and generation use Admin SDK / IAM only.
    match /riddles/{id} { allow read: if true; }
    match /dailyChallenges/{id} { allow read: if true; }
    match /timerRiddlesDaily/{id} { allow read: if true; }
    match /adminSettings/riddleSettings { allow read: if true; }
    match /users/{uid} {
      // Existing releases calculate rewards on-device. This isolates players;
      // it does not make their client-calculated coin balances cheat-proof.
      allow read, write: if owns(uid);
      match /{collection}/{id} {
        allow read, write: if owns(uid) && collection in [
          'riddleProgress', 'dailychallengeprogress',
          'timerDailyChallengeProgress', 'dailyTenRiddles'
        ];
      }
    }
    match /puzzleReports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'riddleId', 'reason', 'answer', 'details', 'createdAt', 'status'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.riddleId is string
        && request.resource.data.riddleId.size() > 0 && request.resource.data.riddleId.size() <= 150
        && request.resource.data.reason in ['answer', 'hint', 'image']
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 200
        && request.resource.data.details is string && request.resource.data.details.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open';
    }
    match /contactUs/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'name', 'email', 'message', 'timestamp'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() <= 320
        && request.resource.data.message is string && request.resource.data.message.size() <= 10000
        && request.resource.data.timestamp == request.time;
    }
  }
}
